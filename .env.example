# CollabBoard Root Environment Sample (Session 5 - DevOps & Dockerization)
# Copy this template to .env before starting Docker Compose:
# cp .env.example .env

# Security Secrets (Session 2 & Session 5)
JWT_SECRET=fullstack-development-secret

# Backend Service Configuration
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:9090
MONGODB_URI=mongodb://mongo:27017/collabboard
MONGO_URI=mongodb://mongo:27017/collabboard

# Frontend Service Configuration (empty string uses same-origin proxying via Nginx)
VITE_API_URL=
